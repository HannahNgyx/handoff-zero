# Medplum (email/password demo sign-in + FHIR + WebSocket subscriptions)
NEXT_PUBLIC_MEDPLUM_BASE_URL=https://api.medplum.com/
NEXT_PUBLIC_MEDPLUM_CLIENT_ID=

# Deepgram Voice Agent (server-only — browser gets short-lived JWT via /api/deepgram/token)
# Must be Member permission or higher (grant endpoint rejects lower scopes with 403)
DEEPGRAM_API_KEY=

